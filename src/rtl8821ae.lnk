# SPDX-License-Identifier: GPL-2.0-only
# wlink directives for RTL8821AE.OS2 (the container of the RTL88EU / QCA6174 / iwlwifi drivers: 16-bit NE "dll" with
# an IOPL code segment, no default libraries). hdr.obj must be first, end.obj last.
format os2 dll
name RTL8821AE.OS2
option quiet,map=RTL8821AE.map,verbose,caseexact,eliminate,nodefaultlibs
option description '@#psmedley:0.0.2#@##1## 27 Nov 2026 12:00:00     ARCAOS-DEV::en:US:2:::@@Realtek RTL8821AE PCIe WiFi driver for OS/2 and ArcaOS (GenMAC + NDIS) dev'
segment class 'CODE' iopl
import DOSOPEN DOSCALLS.70
import DOSCLOSE DOSCALLS.59
import DOSREAD DOSCALLS.137
import DOSDEVIOCTL DOSCALLS.53
file obj/ae/hdr.obj
file obj/ae/lib.obj
file obj/ae/ndisx.obj
file obj/ae/strat.obj
file obj/ae/pci.obj
file obj/ae/mem.obj
file obj/ae/rtw_io.obj
file obj/ae/rtw_hal.obj
file obj/ae/rtw_phy.obj
file obj/ae/rtw_trx.obj
file obj/ae/rtw_sta.obj
file obj/ae/rtw_tbl.obj
file obj/ae/sta.obj
file obj/ae/ndis.obj
file obj/ae/genmac.obj
file obj/ae/dbg.obj
file obj/ae/end.obj
